{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdReader",
  "mainBinaryName": "mdr",
  "version": "0.1.0",
  "identifier": "com.laoh.mdreader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MdReader",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBREYwNjkxRjc5ODdBMjcKUldRbmVwajNrUWJmeXFtNklTU0VUK2VrNVhQaThXU2ZxSVNLbis4V21NYkQwMXJRcUZtYlJUSVYK",
      "endpoints": ["https://github.com/pyjhoop/MdReader/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
